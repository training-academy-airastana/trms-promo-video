{
  "name": "trms-motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts --port=3000",
    "typecheck": "tsc --noEmit",
    "voice:plan": "node --env-file=.env.local scripts/voiceover.mjs plan",
    "voice:list": "node --env-file=.env.local scripts/voiceover.mjs voices",
    "voice:generate": "node --env-file=.env.local scripts/voiceover.mjs generate",
    "audio:generate": "node --env-file=.env.local scripts/produce-audio.mjs",
    "audio:mix": "python scripts/mix-audio.py"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.538",
    "@remotion/media": "4.0.538",
    "@remotion/three": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
